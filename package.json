{
  "name": "tutor-ia",
  "version": "1.3.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "build:static": "node scripts/build.mjs --static",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx scripts/test-client-logic.ts && tsx --test scripts/*.test.ts",
    "android:sync": "npm run build:static && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "cd android && ./gradlew :app:assembleDebug",
    "android:apk:preview": "cd android && ./gradlew :app:assemblePreview",
    "android:apk:release": "cd android && ./gradlew :app:assembleRelease",
    "test:integration": "playwright test"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@google/genai": "^2.31.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "@capacitor/cli": "^8.5.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
