# Chave da API do Google Gemini (obrigatória no modo "Servidor")
# Obtém a tua chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Configuração do servidor (valores validados, nunca escolhidos pelo pedido HTTP).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=HIGH
# Configuração pública do modo direto, incorporada no build web/Android.
NEXT_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
NEXT_PUBLIC_GEMINI_THINKING_LEVEL=HIGH
# Apenas durante a transição de clientes web antigos; retirar após atualização.
GEMINI_ALLOW_LEGACY_KEYS=0
